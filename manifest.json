{
  "manifest_version": 3,
  "name": "Static Title Tabs",
  "description": "Sets saved titles for exact URLs and can keep selected tabs active.",
  "version": "1.0.0",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Static Title Tabs",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
